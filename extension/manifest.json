{
  "manifest_version": 3,
  "name": "LeetCode Discord Presence",
  "version": "0.1.1",
  "description": "Shows the LeetCode problem you are working on as your Discord activity.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:47391/*", "https://leetcode.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "LeetCode Discord Presence", "default_popup": "popup.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "leetcode-rpc@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
