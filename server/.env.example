# Application ID from the Discord Developer Portal (General Information)
DISCORD_CLIENT_ID=

# Name of the art asset uploaded under Rich Presence > Art Assets
LARGE_IMAGE_KEY=leetcode
LARGE_IMAGE_TEXT=LeetCode

# Make the problem title and the image on the card clickable (opens the LeetCode problem).
# Set to 0 to turn it off.
LINK_PROBLEM=1

# Set to 1 to add an "Open problem" button that other people can see
SHOW_BUTTON=0

# Milliseconds without a heartbeat before the presence is cleared
TTL_MS=90000

PORT=47391
